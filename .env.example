# Copy this file to .env.local and fill in your values.
#
# SECURITY: .env.local holds real secrets. It is gitignored AND .dockerignored,
# so it is never committed and never baked into the Docker image. Keep it that way
# - inject secrets at runtime (env_file / orchestrator secrets), never at build time.
#
# The app validates required variables at startup (lib/env.ts). In production a
# missing REQUIRED variable stops the process with a clear error.

# --- REQUIRED (production) ---------------------------------------------------

# NextAuth - signs sessions AND derives the encryption key (lib/crypto.ts) for
# stored email passwords, LinkedIn cookies, API keys, and webhook secrets.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the app, used by NextAuth for redirects. Strongly recommended;
# also the default base for email open/click tracking links.
NEXTAUTH_URL=http://localhost:3000

# --- RECOMMENDED -------------------------------------------------------------

# Internal secret for server-to-server API calls (e.g. the MCP server calling
# Linki's own /api/* routes over loopback). Never sent to a browser or exposed
# externally - only Node processes on this host see it.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=

# Instance administrators, comma-separated emails. These accounts can open /admin and
# read platform-wide, cross-workspace metrics (read-only, aggregates only).
# Deliberately an env var, not a database role: instance access therefore requires
# deploy access and can never be self-granted through the app. Leave blank to disable
# the admin surface entirely - an empty value means nobody is an administrator.
# SUPERADMIN_EMAILS=you@example.com,ops@example.com
SUPERADMIN_EMAILS=

# Mailbox the instance itself sends from: password-reset links and "confirm your email"
# for new signups. Any SMTP account works (a transactional provider is the usual choice).
# Leave blank and there is no password reset by email, and new signups are let in without
# confirming their address - fine for a private instance, not for one open to the public.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
# The From line, e.g. "Linki <no-reply@yourdomain.com>"
SYSTEM_SMTP_FROM=

# --- OPTIONAL ----------------------------------------------------------------

# Public HTTPS origin used by enhanced email open/click tracking and by the unsubscribe
# link an email gets where its author writes {{unsubscribe}}. In production this must be
# reachable by recipients. Defaults to NEXTAUTH_URL when omitted. An email with the tag
# also tells the mail client (the List-Unsubscribe header), but only when this is an
# https address: mail providers ignore any other kind.
EMAIL_TRACKING_BASE_URL=
# Optional dedicated HMAC secret for signed tracking URLs. Defaults to NEXTAUTH_SECRET.
EMAIL_TRACKING_SECRET=

# Additional HTTPS browser origins allowed to call the hosted MCP endpoint, comma-separated.
# Claude's official https://claude.ai and https://claude.com origins are allowed automatically.
MCP_ALLOWED_ORIGINS=

# Webhooks are refused if they point at a private, loopback or link-local address, so a
# workspace cannot use one to reach this server's own network. Set to "true" only if you
# run the instance for yourself and your webhook receivers live on a private network.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# SQLite database path. Defaults to ./linki.db in cwd.
# When running via Docker, this is set automatically to /data/linki.db
LINKI_DB_PATH=

# Set to "false" to show the browser window during automation (useful for debugging).
HEADLESS=true

# Days to keep waiting for a LinkedIn connection request to be accepted before the contact
# is skipped. Defaults to 30: measured on a live account, over a third of acceptances
# arrived more than a week after the request.
LINKEDIN_ACCEPT_WAIT_DAYS=30

# Invitations each LinkedIn account may withdraw per day. When the wait above runs out the
# unanswered invitation is withdrawn before the contact is skipped, so it does not stay in
# the account's pending list for good. Kept small on purpose. One budget for campaigns,
# the per-account "Withdraw old invitations" clean-up, and the test endpoint.
LINKEDIN_DAILY_WITHDRAW_LIMIT=10

# Base URL of the email verification API (rapid-email-verifier). Defaults to the public
# instance. If this API is unreachable, verification falls back to a local DNS+SMTP probe.
EMAIL_VERIFY_API_URL=https://rapid-email-verifier.fly.dev

# Set to "off" to start the app without any background work: no campaign steps, no email,
# no mailbox reading, no webhooks. For a copy that should only show data, such as a database
# of demo data (npm run seed:demo) or a production copy opened to rehearse an upgrade.
# LINKI_RUNNER=off
